# Backend Environment Variables for MyAI Healthcare
# Copy to .env and fill in your values

# Server
PORT=10000
NODE_ENV=production

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES=7d
ADMIN_EMAILS=admin@example.com

# Database (Render free Postgres optional, JSON works fine)
DATABASE_URL=postgresql://user:pass@localhost:5432/myai  # Local or Render PG
PREFER_POSTGRES=false  # Set true for local PG, false for Render JSON

# Email - SendGrid (recommended for Render, free tier)
SENDGRID_API_KEY=SG.your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# OR SMTP Fallback (Gmail/Outlook - less reliable on Render)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_app_password
# EMAIL_FROM=Your App <your@gmail.com>

# Frontend URL
FRONTEND_URL=https://your-app.onrender.com  # Update for Render
REQUIRE_EMAIL_VERIFICATION=true
